# ══════════════════════════════════════════════════════════════════
# ECG AI 诊断 · .env 写入规则（复制为 .env 后填写；.env 不会被提交）
# ══════════════════════════════════════════════════════════════════
#
# 【加载规则】
# 1. 启动时自动加载项目根目录的 .env；若 .env 不存在，会退回加载本
#    .env.example —— 所以占位符 your-api-key-here 会被当成"已配置"
#    并导致 auth_failed 报错。复制本文件为 .env 后请填入真实密钥。
# 2. 格式：每行 KEY=VALUE，不加分号结尾、不需要引号；# 开头为注释。
# 3. 修改后需要重启 web_app.py 才生效（启动时读取一次）。
#
# 【变量优先级】同名配置会按顺序取第一个非空值
#   API Key:  OPENAI_API_KEY → ECG_API_KEY → GEMINI_API_KEY
#   Base URL: OPENAI_BASE_URL → ECG_API_BASE_URL → 默认 api.gptnb.ai/v1/
#   Model ID: ECG_MODEL_ID → AI_SCIENTIST_MODEL → OPENAI_MODEL → 默认 gemini-pro
#
# 【API Key】必填。从模型服务商控制台获取，形如 sk-xxxxxxxx。
# 不要保留占位符；留空 = 未配置（界面显示 "API not configured"）。
OPENAI_API_KEY=your-api-key-here

# 【Base URL】OpenAI 兼容接口地址。三种写法都可以，客户端会自动补全：
#   https://api.example.com            → 自动补 /v1/chat/completions
#   https://api.example.com/v1         → 自动补 /chat/completions
#   https://api.example.com/v1/chat/completions → 原样使用
OPENAI_BASE_URL=https://api.gptnb.ai/v1/

# 【Model ID】服务商侧的模型名，对应界面预设：
#   gemini-pro / gemini-2.0-flash        (gptnb.ai 代理)
#   gpt-4o / gpt-4o-mini                 (api.openai.com)
#   deepseek-chat                        (api.deepseek.com)
#   qwen-max                             (dashscope.aliyuncs.com)
#   本地/自建服务填服务商给你的模型 ID。
ECG_MODEL_ID=gemini-pro
# 或使用已有变量名（会被 ECG_MODEL_ID 覆盖）：
# AI_SCIENTIST_MODEL=gpt-4o-mini

# 【可选】技术支持联系，供界面 Help 引用
API_SERVICE_CONTACT_NAME=
API_ACCESS_GROUP_LINK=CASES.md
